{% extends "base.html" %}
{% block title %}Product Detail{% endblock %}
{% block styles %}<link rel="stylesheet" href="style.css" />{% endblock %}
{% block content %}
{% if product %}
<div class="detail-container">
    <div class="detail-card">
        <img src="{{ product.image }}" alt="{{ product.name }}" class="detail-img" />
        <div class="detail-info">
            <h1 class="detail-title">{{ product.name }}</h1>
            <p class="detail-price">{{ product.price }} $</p>
            <p class="detail-description">{{ product.details }}</p>
            <div class="detail-actions">
                <a href="/products" class="btn">Back to Products</a>
                <a href="/delete?id={{ product.id }}" class="btn btn-danger">Delete Product</a>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="detail-container">
    <p class="not-found">Product not found.</p>
</div>
{% endif %}
{% endblock %}
